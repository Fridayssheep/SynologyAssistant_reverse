;==================================================================
; Synology Disk Station Virtual USB Setup File
; Copyright (c) 2010 Synology
;==================================================================
[Version]
Signature="$WINDOWS NT$"
Class=System
ClassGuid={4D36E97D-E325-11CE-BFC1-08002BE10318}
;Class=USB
;ClassGuid={36FC9E60-C465-11CF-8056-444553540000}
Provider=%INF-creator%
DriverVer=08/27/2012,1.0.0002.4
CatalogFile.NT=synodriverx86.cat

;/* dirid 12: Drivers on WinNT platforms */
;/*       11: system32 on WinNT platforms */
[DestinationDirs]
DefaultDestDir = 12

[SourceDisksNames]
1 = %DiskId1%,,,""

[SourceDisksNames.amd64]
1 = %DiskId1%,,,""

[SourceDisksNames.ia64]
1 = %DiskId1%,,,""


[SourceDisksFiles]
busenum.sys  = 1,,

[SourceDisksFiles.ia64]
busenum.sys  = 1,,

[SourceDisksFiles.amd64]
busenum.sys  = 1,,

;*****************************************
; Virutal_USB  Install Section
;*****************************************

[Manufacturer]
%Company%=Standard,NTAMD64,NTIA64

[DefaultInstall]
CopyFiles=Drivers_Dir

;INF Models Section
[Standard]
; Virutal_USB hub pnp ids
%Virutal_USB.DeviceDesc%=Virutal_USB, root\busenum

[Standard.NTAMD64]
%Virutal_USB.DeviceDesc%=Virutal_USB, root\busenum

[Standard.NTIA64]
%Virutal_USB.DeviceDesc%=Virutal_USB, root\busenum

;INF DDInstall Section

[Virutal_USB.NT]
CopyFiles=Drivers_Dir

[Virutal_USB.NTAMD64]
CopyFiles=Drivers_Dir

[Virutal_USB.NTIA64]
CopyFiles=Drivers_Dir

[Virutal_USB.NT.HW]
AddReg=Virutal_USB.NT.AddReg

[Virutal_USB.NTAMD64.HW]
AddReg=Virutal_USB.NT.AddReg

[Virutal_USB.NTIA64.HW]
AddReg=Virutal_USB.NT.AddReg

[Virutal_USB.NT.AddReg]                            
HKR,,DeviceCharacteristics,0x10001,0x0100         ; Use same security checks on relative opens
HKR,,Security,,"D:P(A;;GA;;;BA)(A;;GA;;;SY)"      ; Allow generic-all access to Built-in administrators and Local system 

[Drivers_Dir]
busenum.sys


;-------------- Service installation
[Virutal_USB.NT.Services]
AddService = busenum,%SPSVCINST_ASSOCSERVICE%, busenum_Service_Inst

[Virutal_USB.NTAMD64.Services]
AddService = busenum,%SPSVCINST_ASSOCSERVICE%, busenum_Service_Inst

[Virutal_USB.NTIA64.Services]
AddService = busenum,%SPSVCINST_ASSOCSERVICE%, busenum_Service_Inst

; -------------- busenum driver install sections
[busenum_Service_Inst]
DisplayName    = %busenum.SVCDESC%
ServiceType    = 1               ; SERVICE_KERNEL_DRIVER
StartType      = 3               ; SERVICE_DEMAND_START 
ErrorControl   = 1               ; SERVICE_ERROR_NORMAL
ServiceBinary  = %12%\busenum.sys
LoadOrderGroup = Extended Base


[Strings]
SPSVCINST_ASSOCSERVICE= 0x00000002
INF-creator = "Synology"
Company = "Synology Inc"
DiskId1 = "Synolgy USB Client Installation Disk #1"
Virutal_USB.DeviceDesc = "Synology Virtual USB Hub"
busenum.SVCDESC = "Synology Virtual USB Hub"

